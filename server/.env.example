# ─── Server Configuration ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas Database ──────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/tnau-guesthouse?retryWrites=true&w=majority

# ─── Razorpay Payment Gateway (Test Mode) ────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# ─── Email Notifications (Resend HTTPS API - 100 emails/day FREE) ─────────────
RESEND_API_KEY=re_your_api_key_here

# ─── Email Notifications (Nodemailer + Gmail SMTP - fallback) ─────────────────
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# ─── Admin Security PIN ──────────────────────────────────────────────────────
ADMIN_PIN=1234
